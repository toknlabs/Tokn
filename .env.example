# Copy to .env and fill in. Never commit .env — the secret key is a full-access
# credential.

# The Supabase project: https://<project-ref>.supabase.co
SUPABASE_URL=

# Server-side only. A secret key (sb_secret_...) bypasses row-level security.
# Create at: Supabase dashboard -> Project Settings -> API Keys -> Secret keys
SUPABASE_SECRET_KEY=

# The Postgres schema the tokn tables live in, kept separate from anything else
# in the project. It must be listed under Data API -> Exposed schemas.
TOKN_SCHEMA=tokn

# Public origin used to build profile links returned to the CLI.
TOKN_PUBLIC_URL=https://toknhq.com

# Vercel Cron sends this as `Authorization: Bearer …` when it calls
# GET /api/cron/refresh-pricing. Without it the route refuses the request.
CRON_SECRET=

# GitHub sign-in. Create an OAuth App under the eaonlabs organization:
#   https://github.com/organizations/eaonlabs/settings/applications/new
# Authorization callback URL must match exactly:
#   http://localhost:3000/api/auth/github/callback   (dev)
# Leave blank to hide the "continue with github" button entirely.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional override; defaults to TOKN_PUBLIC_URL + /api/auth/github/callback
GITHUB_CALLBACK_URL=

# The Eaon Desktop board's host. Requests on any host in TOKN_EAON_HOSTS
# (comma-separated, host or host:port) serve the Eaon pages; links and
# canonical URLs point at TOKN_EAON_URL. Defaults: tokns.eaon.dev.
# TOKN_EAON_HOSTS=tokns.eaon.dev
# TOKN_EAON_URL=https://tokns.eaon.dev

# Local development only: render every page from placeholder fixtures instead
# of Appwrite. Ignored in production builds.
# TOKN_FIXTURES=1
