{
  "name": "tokn-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Appwrite-backed persistence and API logic for the tokn leaderboard.",
  "main": "src/index.ts",
  "scripts": {
    "provision": "node --experimental-strip-types src/provision.ts",
    "provision:reset": "node --experimental-strip-types src/provision.ts --reset",
    "seed:pricing": "node --experimental-strip-types src/seed-pricing.ts",
    "verify": "node --experimental-strip-types src/verify.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test ../pricing/catalog.test.ts test/*.test.ts",
    "dev": "node --experimental-strip-types src/server.ts"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.3",
    "node-appwrite": "^17.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "license": "GPL-3.0-or-later"
}
